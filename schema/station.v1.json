{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/ooep/JR-nearby/schema/station.v1.json",
  "title": "JR-nearby station file v1",
  "type": "object",
  "required": ["schema", "station", "generated_at", "pois", "coverage"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "station.v1" },
    "station": {
      "type": "object",
      "required": ["id", "name", "line_group", "pref", "lat", "lon"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^st[0-9]{5}$" },
        "name": { "$ref": "#/definitions/i18n_name" },
        "line_group": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
        "pref": { "type": "string", "minLength": 1 },
        "lat": { "type": "number", "minimum": 20, "maximum": 46 },
        "lon": { "type": "number", "minimum": 122, "maximum": 154 }
      }
    },
    "generated_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}" },
    "pois": { "type": "array", "items": { "$ref": "#/definitions/poi" } },
    "coverage": {
      "type": "object",
      "required": ["poi_count", "radius_m", "confidence", "gaps"],
      "additionalProperties": false,
      "properties": {
        "poi_count": { "type": "integer", "minimum": 0 },
        "radius_m": { "type": "integer", "minimum": 200, "maximum": 2000 },
        "confidence": { "enum": ["high", "medium", "low"] },
        "gaps": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    }
  },
  "definitions": {
    "i18n_name": {
      "type": "object",
      "required": ["ja", "en", "zh"],
      "additionalProperties": false,
      "properties": {
        "ja": { "type": "string", "minLength": 1, "maxLength": 80 },
        "en": { "type": "string", "minLength": 1, "maxLength": 120 },
        "zh": { "type": "string", "minLength": 1, "maxLength": 80 }
      }
    },
    "i18n_desc": {
      "type": "object",
      "required": ["ja", "en", "zh"],
      "additionalProperties": false,
      "properties": {
        "ja": { "type": "string", "minLength": 40, "maxLength": 120 },
        "en": { "type": "string", "minLength": 40, "maxLength": 120 },
        "zh": { "type": "string", "minLength": 40, "maxLength": 120 }
      }
    },
    "poi": {
      "type": "object",
      "required": ["id", "category", "name", "desc", "distance_m", "walk_min", "hours", "url", "tel", "price_level", "source", "verified_at"],
      "properties": {
        "id": { "type": "string", "pattern": "^st[0-9]{5}-[0-9]{3}$" },
        "category": { "enum": ["sight", "shrine_temple", "food", "cafe", "shopping", "onsen_sento", "park", "entertainment", "lodging", "public_service"] },
        "name": { "$ref": "#/definitions/i18n_name" },
        "desc": { "$ref": "#/definitions/i18n_desc" },
        "distance_m": { "type": "integer", "minimum": 1, "maximum": 2000 },
        "walk_min": { "type": "integer", "minimum": 1, "maximum": 40 },
        "hours": { "type": ["string", "null"], "maxLength": 200 },
        "url": { "type": "string", "pattern": "^https?://[^ ]+$" },
        "tel": { "type": ["string", "null"], "maxLength": 32 },
        "price_level": { "anyOf": [ { "type": "null" }, { "enum": ["¥", "¥¥", "¥¥¥", "¥¥¥¥"] } ] },
        "source": { "type": "array", "minItems": 1, "items": { "enum": ["osm", "official_site", "city_page", "tourism_site", "wikipedia", "ja_wiki", "en_wiki", "zh_wiki", "operator_site", "news", "other"] } },
        "verified_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}" },
        "lat": { "type": "number", "minimum": 20, "maximum": 46 },
        "lon": { "type": "number", "minimum": 122, "maximum": 154 }
      }
    }
  }
}
