{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/ooep/JR-nearby/schema/station.v1.json",
  "title": "JR-nearby station file v1",
  "type": "object",
  "required": ["schema", "station", "generated_at", "pois", "coverage"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "station.v1" },
    "station": {
      "type": "object",
      "required": ["id", "name", "line_group", "pref", "lat", "lon"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^st[0-9]{5}$" },
        "name": { "$ref": "#/definitions/i18n_name" },
        "line_group": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
        "pref": { "type": "string", "minLength": 1 },
        "lat": { "type": "number", "minimum": 20, "maximum": 46 },
        "lon": { "type": "number", "minimum": 122, "maximum": 154 }
      }
    },
    "generated_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "pois": { "type": "array", "items": { "$ref": "#/definitions/poi" } },
    "coverage": {
      "type": "object",
      "required": ["poi_count", "radius_m", "confidence", "gaps"],
      "additionalProperties": false,
      "properties": {
        "poi_count": { "type": "integer", "minimum": 0 },
        "radius_m": { "const": 2000, "description": "收录半径恒为 2000m（步行口径），不允许按站缩小" },
        "confidence": { "enum": ["high", "medium", "low"] },
        "gaps": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "fetch_truncated": { "type": "boolean", "description": "抓取上限语义：候选抓取本身被查询输出上限截断时为 true，此时 candidate_count 只是下限。候选多但只收录少数不是截断，那是 selected_cap 筛选" },
        "selected_cap": { "type": ["integer", "null"], "minimum": 1, "description": "展示上限语义：本站执行的选材条数上限（样板期政策为 20）。candidate_count 远大于 selected_cap 属正常筛选结果，必须与 fetch_truncated 分开表述" },
        "candidate_count": { "type": "integer", "minimum": 0, "description": "2km 圈内抓到的具名候选总数；fetch_truncated=true 时为下限值，否则为准确值" },
        "excluded_candidates": {
          "type": "array",
          "description": "抓到但未入选的具名候选及原因（对账用，如山峰非设施类）",
          "items": {
            "type": "object",
            "required": ["name", "reason"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "reason": { "type": "string", "minLength": 1 }
            }
          }
        },
        "floor_check": {
          "type": "object",
          "description": "六类保底存在性检查（medical 硬规则）：candidates>0 必须至少收录 1 条；==0 必须在 gaps 写明缺失。六类必须齐全。",
          "required": ["medical", "bank_atm", "convenience", "post_office", "police", "tourist_info"],
          "additionalProperties": false,
          "properties": {
            "medical":      { "$ref": "#/definitions/floor_entry" },
            "bank_atm":     { "$ref": "#/definitions/floor_entry" },
            "convenience":  { "$ref": "#/definitions/floor_entry" },
            "post_office":  { "$ref": "#/definitions/floor_entry" },
            "police":       { "$ref": "#/definitions/floor_entry" },
            "tourist_info": { "$ref": "#/definitions/floor_entry" }
          }
        }
      }
    }
  },
  "definitions": {
    "floor_entry": {
      "type": "object",
      "required": ["candidates"],
      "additionalProperties": false,
      "properties": {
        "candidates": { "type": "integer", "minimum": 0, "description": "2km 圈内该类 Overpass 具名候选数" },
        "selected": { "type": "integer", "minimum": 0, "description": "实际收录条数" },
        "note": { "type": "string", "description": "取舍说明（如未选最近候选的理由）" }
      }
    },
    "i18n_name": {
      "type": "object",
      "required": ["ja", "en", "zh"],
      "additionalProperties": false,
      "properties": {
        "ja": { "type": "string", "minLength": 1, "maxLength": 80 },
        "en": { "type": "string", "minLength": 1, "maxLength": 120 },
        "zh": { "type": "string", "minLength": 1, "maxLength": 80 }
      }
    },
    "i18n_desc": {
      "type": "object",
      "required": ["ja", "en", "zh"],
      "additionalProperties": false,
      "properties": {
        "ja": { "type": "string", "minLength": 40, "maxLength": 120 },
        "en": { "type": "string", "minLength": 40, "maxLength": 120 },
        "zh": { "type": "string", "minLength": 40, "maxLength": 120 }
      }
    },
    "poi": {
      "type": "object",
      "required": ["id", "category", "name", "desc", "distance_m", "walk_min", "hours", "hours_source", "url", "tel", "tel_source", "price_level", "source", "verified_at"],
      "properties": {
        "id": { "type": "string", "pattern": "^st[0-9]{5}-[0-9]{3}$" },
        "category": {
          "enum": ["sight", "shrine_temple", "food", "cafe", "shopping", "onsen_sento", "park", "entertainment", "lodging", "convenience", "bank_atm", "medical", "post_office", "police", "tourist_info", "public_service"],
          "description": "FROZEN ENUM v2. sight=观光名胜 | shrine_temple=神社佛阁 | food=饮食 | cafe=咖啡·茶座 | shopping=购物 | onsen_sento=温泉·钱汤 | park=公园·庭园 | entertainment=娱乐 | lodging=住宿 | convenience=便利店(24h 属性写进 hours) | bank_atm=银行·ATM | medical=医院·诊所·药房 | post_office=邮局 | police=警察·交番 | tourist_info=观光案内所 | public_service=其余 civic(市役所·区役所/图书馆/社区中心等)。合并仅限同一设施的别名/多入口(须带 aka[] 与 merged_ids[])；不同名字的独立景点一律各留一条。新增类别必须修改本 schema 并全量重跑 scripts/validate.py 后方可推送。"
        },
        "name": { "$ref": "#/definitions/i18n_name" },
        "aka": { "type": "array", "items": { "type": "string", "minLength": 1 }, "description": "同一设施的别名（仅别名合并时使用）" },
        "merged_ids": { "type": "array", "items": { "type": "string", "minLength": 1 }, "description": "被合并来源的引用，如 osm:node/123 或 stNNNNN-NNN" },
        "desc": { "$ref": "#/definitions/i18n_desc" },
        "distance_m": { "type": "integer", "minimum": 1, "maximum": 2000 },
        "walk_min": { "type": "integer", "minimum": 1, "maximum": 40 },
        "hours": { "type": ["string", "null"], "maxLength": 200, "description": "营业时间必须带时区语义（JST），如 10:00-18:00 (JST)；拿不到可靠来源写 null" },
        "hours_source": { "enum": ["osm", "official", "unknown"], "description": "hours 的证据来源；hours=null 时必须为 unknown（前端显示'未确认'）。official 表示从官网正文抽取，必须同时给 hours_checked_at" },
        "hours_checked_at": { "anyOf": [ { "type": "null" }, { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" } ], "description": "官网正文核对营业时间的日期；hours_source=official 时必填" },
        "closed_on": { "type": ["string", "null"], "maxLength": 120, "description": "定休日/闭馆日（如 月曜日、年末年始）；无可靠来源写 null" },
        "url": { "type": "string", "pattern": "^https?://[^ ]+$" },
        "official_url_pending": { "type": "string", "pattern": "^https?://[^ ]+$", "description": "已知官网但抓取端被反爬拦截(403/503/超时)的待升级 URL；CI 在 runner 上复测 200 后回填到 url" },
        "tel": { "type": ["string", "null"], "maxLength": 32 },
        "tel_source": { "enum": ["osm", "official", "unknown"], "description": "tel 的证据来源；tel=null 时必须为 unknown" },
        "price_level": { "anyOf": [ { "type": "null" }, { "enum": ["¥", "¥¥", "¥¥¥", "¥¥¥¥"] } ] },
        "source": { "type": "array", "minItems": 1, "items": { "enum": ["osm", "official_site", "city_page", "tourism_site", "wikipedia", "ja_wiki", "en_wiki", "zh_wiki", "operator_site", "news", "other"] } },
        "verified_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}" },
        "lat": { "type": "number", "minimum": 20, "maximum": 46 },
        "lon": { "type": "number", "minimum": 122, "maximum": 154 }
      }
    }
  }
}
